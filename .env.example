# Chép file này thành .env rồi chỉnh nếu cần. KHÔNG commit .env.

# Địa chỉ backend mà app gọi.
# Emulator Android 17 chặn app gọi 10.0.2.2 (coi là "mạng nội bộ", cần quyền ACCESS_LOCAL_NETWORK —
# https://developer.android.com/privacy-and-security/local-network-permission), nên app gọi localhost và chuyển
# cổng về máy tính bằng `adb reverse tcp:8080 tcp:8080` (chạy lại mỗi lần bật emulator).
EXPO_PUBLIC_API_URL=http://localhost:8080

# Nơi lệnh `npm run gen:api` lấy OpenAPI để sinh src/api/types.gen.ts (backend phải đang chạy)
OPENAPI_URL=http://localhost:8080/v3/api-docs

# (Từ M5) Web client ID của OAuth client loại "Web application" trên Google Cloud Console (dạng
# 1234567890-abc.apps.googleusercontent.com). App gửi nó cho Google để nhận ID token mà backend kiểm được.
# KHÔNG điền Android client ID vào đây. Để trống thì nút "Tiếp tục với Google" báo chưa cấu hình.
# Đổi biến này chỉ cần chạy lại `npx expo start --dev-client -c`, không cần build lại APK.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# (Từ M13b) Đăng nhập Apple / Facebook bằng luồng web (mở trình duyệt, rồi nhà cung cấp chuyển về backend, backend chuyển
# về app qua taskly://oauth/...). Tự tạo ở Apple Developer / Meta for Developers, tự điền; để trống thì nút báo chưa cấu hình.
# Services ID của Sign in with Apple, và URL HTTPS công khai của POST /api/v1/auth/apple/callback trên backend.
EXPO_PUBLIC_APPLE_SERVICE_ID=
EXPO_PUBLIC_APPLE_REDIRECT_URI=
# App ID của Facebook app, và URL công khai của GET /api/v1/auth/facebook/callback trên backend.
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_REDIRECT_URI=

# (Từ X5) iOS — xem mobile/IOS.md. Để trống thì build vẫn chạy, nút Google trên iOS báo chưa cấu hình.
# Client ID của OAuth client loại "iOS" trên Google Cloud Console (Bundle ID com.taskly.app), dạng 1234567890-abc.apps.googleusercontent.com.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# URL scheme của client iOS đó (REVERSED_CLIENT_ID, dạng com.googleusercontent.apps.1234567890-abc). Được app.config.js đọc LÚC BUILD
# để ghi vào Info.plist; đổi biến này phải build lại app. Đọc tên GOOGLE_IOS_URL_SCHEME trước, rồi tới EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME.
GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
