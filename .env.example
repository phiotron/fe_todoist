# Chép file này thành .env rồi chỉnh nếu cần. KHÔNG commit .env.

# Địa chỉ backend mà app gọi.
# Emulator Android 17 chặn app gọi 10.0.2.2 (coi là "mạng nội bộ", cần quyền ACCESS_LOCAL_NETWORK —
# https://developer.android.com/privacy-and-security/local-network-permission), nên app gọi localhost và chuyển
# cổng về máy tính bằng `adb reverse tcp:8080 tcp:8080` (chạy lại mỗi lần bật emulator).
EXPO_PUBLIC_API_URL=http://localhost:8080

# Nơi lệnh `npm run gen:api` lấy OpenAPI để sinh src/api/types.gen.ts (backend phải đang chạy)
OPENAPI_URL=http://localhost:8080/v3/api-docs

# (Từ M5) Web client ID của OAuth client loại "Web application" trên Google Cloud Console (dạng
# 1234567890-abc.apps.googleusercontent.com). App gửi nó cho Google để nhận ID token mà backend kiểm được.
# KHÔNG điền Android client ID vào đây. Để trống thì nút "Tiếp tục với Google" báo chưa cấu hình.
# Đổi biến này chỉ cần chạy lại `npx expo start --dev-client -c`, không cần build lại APK.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
