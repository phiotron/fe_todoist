# Chép file này thành .env rồi chỉnh nếu cần. KHÔNG commit .env.

# Địa chỉ backend mà app gọi. Trên Android emulator, 10.0.2.2 trỏ về localhost của máy tính.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Nơi lệnh `npm run gen:api` lấy OpenAPI để sinh src/api/types.gen.ts (backend phải đang chạy)
OPENAPI_URL=http://localhost:8080/v3/api-docs
